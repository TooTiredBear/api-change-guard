{
  "openapi": "3.0.3",
  "info": {"title": "Customer API", "version": "2.0.0"},
  "paths": {
    "/customers": {
      "get": {
        "operationId": "getCustomer",
        "responses": {
          "200": {
            "description": "A customer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "display_name": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}